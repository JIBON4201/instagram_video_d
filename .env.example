# Copy this file to .env and adjust as needed. `npm start` loads it
# automatically; real environment variables take precedence.

PORT=3000
HOST=0.0.0.0

# Concurrent downloads and queue size.
MAX_CONCURRENT=2
MAX_QUEUED=40

# How long finished files and metadata stay around.
JOB_TTL_MIN=30
RESOLVE_TTL_MIN=10

# Optional working directory. Defaults to <os tmp>/reel-downloader.
# TMP_DIR=/var/tmp/reel-downloader

# Custom binaries, if they are not on PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional cookies for reels that require a login. See README.
# COOKIES_FILE=/absolute/path/to/cookies.txt
# INSTAGRAM_COOKIES_B64=

# Set to 1 when running behind a trusted reverse proxy.
# TRUST_PROXY=1

# Hard limit for a single download.
# DOWNLOAD_TIMEOUT_MS=600000
